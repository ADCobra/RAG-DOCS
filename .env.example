# Copy to .env and fill in before running `docker compose up --build`.
# For a hosted deploy, set these same values in your provider's dashboard.

# Public URL of the deployed frontend. Used for the backend CORS allowlist.
# Comma-separate to allow more than one origin.
CLIENT_URL=http://localhost:3000

# Public URL of the deployed backend. Baked into the frontend bundle at BUILD
# time, so changing it requires a rebuild, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Shared secret between the Express backend and the FastAPI genai service.
# Generate with: openssl rand -hex 16
FASTAPI_KEY=

# Signs the auth JWT. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7
COOKIE_EXPIRES_IN=7

# Google OAuth client ID for "Continue with Google" (optional).
GOOGLE_CLIENT_ID=

# Required by the genai service. Without a valid PINECONE_API_KEY the service
# fails during import, not at request time, and will not start at all.
PINECONE_API_KEY=
GOOGLE_API_KEY=
